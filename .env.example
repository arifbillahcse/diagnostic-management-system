APP_NAME=DMS
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Control database. Each clinic gets its own database next to it.
# The user below must be allowed to CREATE DATABASE and CREATE USER,
# because creating a clinic creates both.
DB_DRIVER=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=dms_control
DB_USERNAME=dms
DB_PASSWORD=

# Clinic databases are named <prefix><clinic id>.
CLINIC_DB_PREFIX=dms_clinic_
CLINIC_DB_SEPARATE_USERS=true
CLINIC_DB_USER_HOST=127.0.0.1

# TEMPORARY (trial): let the clinic owner apply database updates from the portal.
DMS_PORTAL_UPDATES=false

# Messaging module: the SMS gateway for the whole installation.
# SMS_DRIVER: log (test mode, nothing is sent), http, or off.
SMS_DRIVER=log
SMS_HTTP_URL=
SMS_HTTP_METHOD=post
SMS_HTTP_PARAMS="api_key={api_key}&senderid={sender}&number={to}&message={message}"
SMS_API_KEY=
SMS_SENDER_ID=
SMS_HTTP_SUCCESS_TEXT=

# Nightly backups. Leave BACKUP_PATH empty to switch them off.
# Copy the folder to another place (another server or cloud storage) every
# night; a backup on the same disk does not survive losing the server.
BACKUP_PATH=
BACKUP_PASSPHRASE=
BACKUP_KEEP_DAYS=30

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Set to true in production, where the site is served over HTTPS only.
SESSION_SECURE_COOKIE=false

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
